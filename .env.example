# Copy to .env and adjust. Never commit the filled file.

# --- where the User Manager portal lives -----------------------------------
# Either give the full URL ...
UM_TARGET_URL=
# ... or the parts. UM_HOST may also carry its own scheme and port.
UM_PROTO=http
UM_HOST=192.168.216.1
UM_PORT=12008

# Accept the self signed certificate a RouterOS portal usually serves.
# Set to false only when the portal has a certificate you can verify.
UM_INSECURE_SKIP_VERIFY=true

# --- the local API ---------------------------------------------------------
# LISTEN_ADDR wins over PORT when both are set.
LISTEN_ADDR=:8080
# PORT=8080

# Seconds to wait before invalidating the portal session of a request.
LOGOUT_DELAY_SECONDS=60

# Timeout for the login plus the two reads. The portal is on the LAN, so a
# short budget keeps failed requests cheap.
REQUEST_TIMEOUT_SECONDS=6

# Value sent in Access-Control-Allow-Origin. Set the exact hotspot origin in
# production instead of the wildcard.
ALLOWED_ORIGIN=*

# Return the memory of a finished session to the operating system as soon as
# the delayed logout has run. Keep this enabled on memory constrained routers.
RELEASE_MEMORY_ON_SESSION_END=true

# Go runtime tuning that keeps the heap small on a RouterOS container.
GOGC=20
GOMEMLIMIT=4MiB
