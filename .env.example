# كل المتغيرات اختيارية، وهذه قيمها الافتراضية.

# عنوان بوابة اليوزر منجر: إما رابط كامل هنا...
# UM_TARGET_URL=http://192.168.216.1:12008
# ...أو عبر الأجزاء الثلاثة، وهي القيم المستخدمة افتراضياً.
UM_PROTO=http
UM_HOST=192.168.216.1
UM_PORT=12008

# منفذ الخدمة المحلية (يمكن استخدام PORT بدلاً منه).
LISTEN_ADDR=:8080

# التأخير بالثواني قبل إغلاق جلسة البوابة.
LOGOUT_DELAY_SECONDS=60

# مهلة تسجيل الدخول والقراءة بالثواني.
REQUEST_TIMEOUT_SECONDS=8

# اجعلها false إذا كانت شهادة البوابة موثوقة وتريد التحقق منها.
UM_INSECURE_SKIP_VERIFY=true
